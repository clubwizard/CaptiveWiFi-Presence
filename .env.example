APP_NAME="CaptiveWiFi Analytics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
# Use 'central' connection for landlord database
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=captivewifi_landlord
DB_USERNAME=postgres
DB_PASSWORD=

# Session Configuration
# Use Redis for better multi-tenant session handling
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue Configuration
# Use Redis for better performance with multiple tenants
QUEUE_CONNECTION=redis

# Cache Configuration
# Use Redis for multi-tenant cache isolation
CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis Configuration
# Use predis client (pure PHP, no extension required)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@analytics.captivewifi.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS Configuration (if using S3 for storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Multi-Tenancy Configuration
# Central domains that host the landlord app (not tenant subdomains)
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1,analytics.captivewifi.com

# Analytics Configuration
# Data retention policy in days (default: 90 days)
ANALYTICS_RETENTION_DAYS=90

# FortiGate Polling Configuration
# How often to poll FortiGate devices (in seconds)
FORTIGATE_POLL_INTERVAL=60
FORTIGATE_API_TIMEOUT=10

VITE_APP_NAME="${APP_NAME}"
